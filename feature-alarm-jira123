import java.util.Timer;
import java.util.TimerTask;

public class AlarmExample {
    public static void main(String[] args) {
        Timer timer = new Timer();

        // Set delay in milliseconds (e.g., 5000 ms = 5 seconds)
        int delay = 5000;

        timer.schedule(new TimerTask() {
            @Override
            public void run() {
                System.out.println("⏰ Alarm! Time's up!");
                // You can add sound or other actions here
            }
        }, delay);

        System.out.println("Alarm set for 5 seconds...");
    }
}
